{
  "name": "edge-cms",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/node/server.ts --bundle --platform=node --format=esm --target=node22 --loader:.html=text --loader:.css=text --loader:.sql=text --outfile=dist/server.mjs --log-level=warning",
    "start": "npm run build && node --disable-warning=ExperimentalWarning dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test tests/e2e.mjs",
    "test:cloudflare": "node --test tests/e2e.cloudflare.mjs",
    "test:all": "npm test && npm run test:cloudflare"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "wrangler": "^4.0.0"
  }
}

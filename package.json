{
  "name": "edge-cms",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/node/server.ts --bundle --platform=node --format=esm --target=node22 --loader:.html=text --loader:.css=text --loader:.sql=text --loader:.png=binary --loader:.jpg=binary --loader:.jpeg=binary --loader:.webp=binary --loader:.avif=binary --loader:.ico=binary --outfile=dist/server.mjs --log-level=warning && esbuild src/lib/template.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/template.mjs --log-level=warning",
    "start": "npm run build && node --disable-warning=ExperimentalWarning dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test:watch": "npm run build && node --disable-warning=ExperimentalWarning --test --watch tests/template.test.mjs tests/panel.test.mjs tests/e2e.mjs",
    "test": "npm run check:assets && npm run build && npm run check:budgets && node --disable-warning=ExperimentalWarning --test tests/template.test.mjs tests/panel.test.mjs tests/e2e.mjs",
    "test:cloudflare": "node --test tests/e2e.cloudflare.mjs",
    "test:all": "npm test && npm run test:cloudflare",
    "check:assets": "node scripts/check-assets.mjs",
    "check:budgets": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "wrangler": "^4.0.0"
  }
}

{
  "manifest_version": 3,
  "name": "Ahmed Pro Theme",
  "slug": "ahmed-pro-theme",
  "version": "1.0.0",
  "author": "Ahmed",
  "description": "A professional, fully responsive theme with dark mode, dropdown menus, page hierarchy styling, social icons and a rich footer.",
  "cms_compatibility": {
    "min": "0.9.0",
    "max": "0.9.x"
  },
  "preview": [
    "#f6f8fc",
    "#0f1a2c",
    "#2457d6"
  ],
  "screenshot": "screenshot.png",
  "required_templates": [
    "base",
    "home",
    "page",
    "post",
    "archive",
    "404"
  ],
  "optional_templates": [
    "search"
  ],
  "features": [
    "menus",
    "page-hierarchy",
    "responsive-navigation",
    "theme-settings"
  ],
  "menu_locations": [
    "primary",
    "footer"
  ],
  "templates": {
    "404": "templates/404.html",
    "base": "templates/base.html",
    "home": "templates/home.html",
    "page": "templates/page.html",
    "post": "templates/post.html",
    "archive": "templates/archive.html",
    "search": "templates/search.html"
  },
  "partials": {
    "header": "partials/header.html",
    "navigation": "partials/navigation.html",
    "footer": "partials/footer.html"
  },
  "css": "static/css/style.css",
  "asset_entrypoints": {
    "css": "static/css/style.css",
    "js": [
      "static/js/theme.js"
    ]
  },
  "assets": [
    "static/js/theme.js",
    "screenshot.png"
  ],
  "settings_schema": "config/settings.json",
  "changelog": [
    {
      "version": "1.0.0",
      "notes": "Initial release: dark mode, dropdown menus, social icons, top bar, rich footer, share buttons."
    }
  ]
}

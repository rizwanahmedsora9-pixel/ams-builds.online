{
  "name": "AMS Journal",
  "slug": "ams-journal",
  "version": "1.0.0",
  "author": "AMS",
  "description": "Single column, serif, generous whitespace and large images. A reading theme: one thing at a time.",
  "tags": ["serif", "single column", "reading", "blog"],
  "preview": ["#fbf9f4", "#221f1a", "#9c4221"],
  "screenshot": "screenshot.png",
  "templates": {
    "base": "base.html",
    "home": "home.html",
    "page": "page.html",
    "post": "post.html",
    "archive": "archive.html",
    "404": "404.html"
  },
  "partials": {
    "header": "partials/header.html",
    "footer": "partials/footer.html"
  },
  "widgets": ["footer", "after-post"],
  "settings": [
    { "key": "tagline", "type": "text", "label": "Tagline", "default": "Notes, essays and longer thoughts", "help": "Shown under the title on the home page." },
    { "key": "byline", "type": "text", "label": "Byline", "default": "Words by the editor" },
    { "key": "drop_cap", "type": "toggle", "label": "Drop cap on the first paragraph", "default": true },
    { "key": "accent", "type": "color", "label": "Accent colour", "default": "#9c4221" },
    { "key": "width", "type": "number", "label": "Measure (characters)", "default": 34, "help": "A comfortable line is 30 to 40 characters per line at this size." },
    { "key": "show_dates", "type": "toggle", "label": "Show dates on the archive", "default": true }
  ],
  "changelog": [
    { "version": "1.0.0", "notes": "First release: serif single column, drop caps, two widget areas." }
  ],
  "assets": ["screenshot.png"],
  "css": "style.css"
}

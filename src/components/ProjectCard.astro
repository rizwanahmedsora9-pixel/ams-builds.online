---
import type { CollectionEntry } from 'astro:content';
export interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const catLabel = { web:'Website', android:'Android App', software:'Software', ecommerce:'E-commerce' }[project.data.category];
---
<article class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-soft transition">
  {project.data.coverImage && (
    <a href={`/projects/${project.slug}/`} class="block aspect-[16/9] overflow-hidden bg-slate-100">
      <img
        src={project.data.coverImage}
        alt={project.data.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-500"
        onerror="this.parentElement.style.display='none'"
      />
    </a>
  )}
  <div class="p-6">
    <span class="inline-block bg-slate-900 text-white text-xs font-bold px-3 py-1 rounded-full">{catLabel}</span>
    <h3 class="mt-3 text-lg font-bold text-slate-900"><a href={`/projects/${project.slug}/`} class="hover:text-amber-600">{project.data.title}</a></h3>
    <p class="mt-2 text-sm text-slate-600 leading-6 line-clamp-3">{project.data.description}</p>
    {project.data.technologies?.length > 0 && <div class="flex flex-wrap gap-1.5 mt-4">{project.data.technologies.map(t => <span class="text-xs bg-slate-100 px-2 py-1 rounded-md text-slate-600">{t}</span>)}</div>}
    <a href={`/projects/${project.slug}/`} class="inline-flex mt-4 text-sm font-bold text-amber-600">View case study →</a>
  </div>
</article>

---
/*
 * IntroOverlay — full-screen entrance screen shown once per session.
 * - Auto-swiping catalogue of landing-page designs (CSS-driven carousel, 4s).
 * - LOCAL mp3 playlist (fixed order, loops, NO shuffle) starts from the
 *   "Start demo" button (browsers require a click before audio can play).
 *   While music plays only an animated equalizer is shown — no track names.
 *     1. /audio/baila-lento.mp3        — BAILA LENTO (sma$her & MC DA$ILVA)
 *     2. /audio/tulin-tulin-phonk.mp3  — Tulin Tulin (phonk)
 * - "Enter" stops the music, fades the overlay out and reveals the site.
 * - Shown once per session via sessionStorage (key: ams_intro_seen).
 */
const slides = [
  { tag: 'SaaS · Dark mode', title: 'Scale your product.', desc: 'Clean, conversion-focused pages for software companies that want to grow fast.', img: '/images/uploads/project-software.jpg' },
  { tag: 'E-commerce · Bright', title: 'Shop the new season.', desc: 'Vibrant product pages with bold imagery and clear offers that turn browsers into buyers.', img: '/images/uploads/project-retail.jpg' },
  { tag: 'Business · Clean', title: 'Your business, online.', desc: 'Fast, SEO-ready websites for shops, clinics and schools — built to bring in enquiries.', img: '/images/uploads/hero-dashboard.jpg' },
  { tag: 'Agency · Bold', title: 'We build brands.', desc: 'Typography-led agency pages that command attention and win clients.', img: '/images/uploads/blog-gujrat-business.jpg' },
  { tag: 'Android · Mobile', title: 'Apps that feel native.', desc: 'Android apps from UI design to Play Store launch, with ongoing support.', img: '/images/uploads/project-android.jpg' },
];
---
<div
  id="ams-intro-overlay"
  class="fixed inset-0 z-[9999] overflow-y-auto overscroll-contain bg-slate-950 text-slate-100 font-sans transition-opacity duration-700 ease-in-out"
  data-show="true"
>
  <!-- Hidden audio engine: fixed playlist, looped, no shuffle -->
  <audio id="ams-audio-player" preload="auto" playsinline></audio>

  <!-- Ambient backdrop -->
  <div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 -left-40 w-[28rem] h-[28rem] rounded-full bg-amber-500/15 blur-[120px]"></div>
    <div class="absolute -bottom-40 -right-40 w-[28rem] h-[28rem] rounded-full bg-sky-500/10 blur-[120px]"></div>
  </div>

  <div class="relative min-h-full flex flex-col px-5 py-5 sm:px-8 md:px-12 md:py-8 max-w-6xl w-full mx-auto">
    <!-- Top bar: brand + equalizer (equalizer only, shown while music plays) -->
    <header class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="w-9 h-9 rounded-xl bg-amber-500 text-slate-900 grid place-items-center font-black text-lg">A</span>
        <span class="leading-tight">
          <span class="block font-extrabold tracking-tight text-white">AMS Builds</span>
          <span class="block text-[10px] tracking-[0.2em] uppercase text-amber-400 font-semibold">Web &amp; App Studio</span>
        </span>
      </div>
      <div
        id="ams-now-playing"
        class="hidden items-center gap-2 h-9 px-3.5 rounded-full bg-white/5 border border-white/10"
        role="status"
        aria-label="Demo music playing"
      >
        <span class="flex items-end gap-[3px] h-4" aria-hidden="true">
          <span class="w-[3px] h-full rounded-full bg-amber-400 ams-eq-bar" style="animation-delay: 0s;"></span>
          <span class="w-[3px] h-full rounded-full bg-amber-400 ams-eq-bar" style="animation-delay: 0.25s;"></span>
          <span class="w-[3px] h-full rounded-full bg-amber-400 ams-eq-bar" style="animation-delay: 0.5s;"></span>
          <span class="w-[3px] h-full rounded-full bg-amber-400 ams-eq-bar" style="animation-delay: 0.75s;"></span>
        </span>
      </div>
    </header>

    <!-- Hero copy + carousel -->
    <main class="flex-1 flex flex-col justify-center py-8 md:py-10">
      <div class="text-center max-w-2xl mx-auto">
        <p class="text-[11px] sm:text-xs tracking-[0.25em] uppercase text-amber-400 font-semibold">Landing-page catalogue</p>
        <h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-[1.1]">
          Websites &amp; apps that <span class="text-amber-400">convert.</span>
        </h1>
        <p class="mt-4 text-sm sm:text-base md:text-lg text-slate-400 leading-relaxed">
          A preview of the designs we build for businesses in Pakistan and beyond.
        </p>
      </div>

      <div class="mt-8 md:mt-10 w-full max-w-4xl mx-auto">
        <div class="rounded-2xl border border-white/10 bg-slate-900/70 shadow-2xl shadow-black/40 overflow-hidden">
          <div id="ams-carousel-track" class="flex transition-transform duration-700 ease-in-out will-change-transform">
            {slides.map((s) => (
              <article class="flex-shrink-0 w-full grid md:grid-cols-2 gap-5 md:gap-8 items-center p-5 sm:p-6 md:p-8">
                <div class="order-2 md:order-1">
                  <p class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-amber-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>{s.tag}
                  </p>
                  <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-white">{s.title}</h2>
                  <p class="mt-2 text-sm sm:text-base text-slate-400 leading-relaxed">{s.desc}</p>
                </div>
                <div class="order-1 md:order-2 relative aspect-[1200/630] rounded-xl overflow-hidden border border-white/10 bg-slate-800">
                  <img src={s.img} alt={`${s.tag} design preview`} class="w-full h-full object-cover" loading="eager" decoding="async" />
                </div>
              </article>
            ))}
          </div>
        </div>
        <div id="ams-carousel-dots" class="flex justify-center gap-2 mt-5">
          {slides.map((_, i) => (
            <button type="button" class="w-2 h-2 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300" aria-label={`Show design ${i + 1}`}></button>
          ))}
        </div>
      </div>
    </main>

    <!-- Actions -->
    <footer class="flex flex-col items-center gap-4">
      <div id="ams-sound-hint" class="flex flex-col sm:flex-row items-center gap-3">
        <button
          id="ams-start-demo"
          type="button"
          class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white text-slate-900 text-sm sm:text-base font-bold hover:bg-slate-200 transition-colors shadow-lg"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.53.85l10.6-6.86a1 1 0 0 0 0-1.7L9.53 4.29A1 1 0 0 0 8 5.14z"/></svg>
          Start demo
        </button>
        <button
          id="ams-enter-btn"
          type="button"
          class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-amber-500 hover:bg-amber-400 text-slate-900 text-sm sm:text-base font-bold uppercase tracking-widest shadow-[0_0_30px_rgba(245,158,11,0.35)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
        >
          Enter site
          <span aria-hidden="true">→</span>
        </button>
      </div>
      <p id="ams-status" class="text-xs text-amber-300 min-h-[1rem] text-center" aria-live="polite"></p>
      <p class="text-[11px] text-slate-500 tracking-widest uppercase text-center">Best with sound · Headphones recommended</p>
    </footer>
  </div>
</div>

<style>
  #ams-intro-overlay[data-exiting="true"] {
    opacity: 0 !important;
    pointer-events: none;
  }
  #ams-carousel-track > article {
    min-width: 100%;
  }
  .ams-eq-bar {
    transform-origin: bottom;
    animation: ams-eq 0.9s ease-in-out infinite;
  }
  @keyframes ams-eq {
    0%, 100% { transform: scaleY(0.25); }
    50% { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ams-eq-bar { animation: none; }
    #ams-carousel-track { transition: none; }
  }
</style>

<script>
  /* --------------------------------------------------------------
   * Only show once per session
   * -------------------------------------------------------------- */
  const STORAGE_KEY = 'ams_intro_seen';
  const overlay = document.getElementById('ams-intro-overlay');
  const enterBtn = document.getElementById('ams-enter-btn');
  const track = document.getElementById('ams-carousel-track');
  const slides = track?.children;
  const dotsContainer = document.getElementById('ams-carousel-dots');
  const startBtn = document.getElementById('ams-start-demo');
  const statusText = document.getElementById('ams-status');
  const nowPlaying = document.getElementById('ams-now-playing');
  const audio = document.getElementById('ams-audio-player');

  let slideIndex = 0;
  const slideCount = slides ? slides.length : 0;
  let timer = null;

  // Fixed playlist — fixed order, loops forever, NO shuffle
  const PLAYLIST = [
    { src: '/audio/baila-lento.mp3' },
    { src: '/audio/tulin-tulin-phonk.mp3' },
  ];
  let trackIndex = 0;

  // Skip if already seen this session
  const alreadySeen = sessionStorage.getItem(STORAGE_KEY);
  if (alreadySeen) {
    overlay?.remove();
    document.body.style.overflow = '';
  } else {
    // Keep body from scrolling behind overlay
    document.body.style.overflow = 'hidden';

  /* --------------------------------------------------------------
   * LOCAL mp3 playlist — continuous loop, fixed order, no shuffle
   * -------------------------------------------------------------- */
  let exiting = false;
  let playRequest = 0;
  let consecutiveErrors = 0;

  // Button visible while demo is not playing; equalizer visible while it is.
  function showStartButton(message = '') {
    startBtn?.classList.remove('hidden');
    nowPlaying?.classList.add('hidden');
    nowPlaying?.classList.remove('flex');
    if (statusText) statusText.textContent = message;
  }

  function showPlaying() {
    nowPlaying?.classList.remove('hidden');
    nowPlaying?.classList.add('flex');
    startBtn?.classList.add('hidden');
    if (statusText) statusText.textContent = '';
  }

  function loadTrack(index) {
    if (!audio) return;
    trackIndex = ((index % PLAYLIST.length) + PLAYLIST.length) % PLAYLIST.length;
    audio.src = PLAYLIST[trackIndex].src;
  }

  // Call play() directly from the button's click handler so it retains the
  // browser's user activation. Do not fall back to misleading muted playback.
  function requestPlayback() {
    if (!audio || exiting) return;
    const request = ++playRequest;
    audio.muted = false;
    audio.volume = 1;
    let result;
    try {
      result = audio.play();
    } catch (error) {
      showStartButton('Could not start the demo — please try again.');
      return;
    }
    if (result) result.catch((error) => {
      // Ignore an older autoplay attempt if the visitor has already clicked.
      if (exiting || request !== playRequest) return;
      if (error.name === 'NotAllowedError') {
        showStartButton('Tap "Start demo" to hear the music.');
      } else if (error.name !== 'AbortError') {
        showStartButton('Could not start the demo — please try again.');
      }
    });
  }

  audio?.addEventListener('playing', () => {
    if (exiting || audio.muted || audio.volume === 0) return;
    consecutiveErrors = 0;
    showPlaying();
  });

  audio?.addEventListener('ended', () => {
    if (exiting) return;
    loadTrack(trackIndex + 1);
    requestPlayback();
  });

  audio?.addEventListener('error', () => {
    if (exiting) return;
    ++playRequest; // Invalidate the rejected play() for the failed source.
    console.warn('Intro audio failed to load:', audio?.src);
    consecutiveErrors++;
    if (consecutiveErrors < PLAYLIST.length) {
      loadTrack(trackIndex + 1);
      requestPlayback();
    } else {
      showStartButton('Music is unavailable right now — you can still browse.');
    }
  });

  startBtn?.addEventListener('click', () => {
    if (!audio || exiting) return;
    if (audio.error) {
      consecutiveErrors = 0;
      loadTrack(trackIndex);
    }
    requestPlayback();
  });

  loadTrack(0);
  requestPlayback();

  /* --------------------------------------------------------------
   * Auto-swiping carousel (pauses on hover / focus)
   * -------------------------------------------------------------- */
  function updateDots() {
    if (!dotsContainer) return;
    const allDots = dotsContainer.querySelectorAll('button');
    allDots.forEach((d, i) => {
      d.className = i === slideIndex
        ? 'w-8 h-2 rounded-full bg-amber-500 transition-all duration-300'
        : 'w-2 h-2 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300';
    });
  }

  function goToSlide(index) {
    if (!track || slideCount === 0) return;
    slideIndex = ((index % slideCount) + slideCount) % slideCount;
    track.style.transform = `translateX(-${slideIndex * 100}%)`;
    updateDots();
  }

  function nextSlide() {
    goToSlide(slideIndex + 1);
  }

  function startCarousel() {
    if (!track) return;
    clearInterval(timer);
    timer = setInterval(nextSlide, 4000);
  }

  dotsContainer?.querySelectorAll('button').forEach((d, i) => {
    d.addEventListener('click', () => { goToSlide(i); startCarousel(); });
  });

  track?.addEventListener('mouseenter', () => clearInterval(timer));
  track?.addEventListener('mouseleave', startCarousel);

  updateDots();
  startCarousel();

  /* --------------------------------------------------------------
   * ENTER button — stop music, fade out overlay, reveal site
   * -------------------------------------------------------------- */
  function enterSite() {
    if (exiting) return;
    exiting = true;
    ++playRequest;
    if (audio) {
      try { audio.pause(); } catch (e) {}
      try { audio.currentTime = 0; } catch (e) {}
      try { audio.removeAttribute('src'); audio.load(); } catch (e) {}
    }
    clearInterval(timer);
    sessionStorage.setItem(STORAGE_KEY, '1');

    overlay?.classList.add('opacity-0', 'pointer-events-none');
    overlay?.setAttribute('data-exiting', 'true');

    // Fade out then remove from DOM and restore scrolling
    setTimeout(() => {
      overlay?.remove();
      document.body.style.overflow = '';
    }, 900);
  }

  enterBtn?.addEventListener('click', enterSite);

  // Escape dismisses the overlay; Enter and Space retain native button behavior.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') enterSite();
  });
  }
</script>

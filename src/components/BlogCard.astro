---
import type { CollectionEntry } from 'astro:content';
export interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const date = new Date(post.data.pubDate).toLocaleDateString('en-PK', { year:'numeric', month:'long', day:'numeric' });
---
<article class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-soft hover:-translate-y-0.5 transition">
  {post.data.heroImage && <a href={`/blog/${post.slug}/`}><img src={post.data.heroImage} alt={post.data.title} loading="lazy" class="w-full h-48 object-cover group-hover:scale-[1.02] transition duration-500" /></a>}
  <div class="p-6">
    <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
      <time datetime={post.data.pubDate}>{date}</time>
      {post.data.tags?.[0] && <span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full font-semibold">{post.data.tags[0]}</span>}
    </div>
    <h3 class="text-lg font-bold text-slate-900 leading-snug"><a href={`/blog/${post.slug}/`} class="hover:text-amber-600">{post.data.title}</a></h3>
    <p class="mt-2 text-sm leading-6 text-slate-600 line-clamp-3">{post.data.description}</p>
    <a href={`/blog/${post.slug}/`} class="inline-flex items-center gap-1 mt-4 text-sm font-bold text-amber-600 hover:gap-2 transition-all">Read article <span>→</span></a>
  </div>
</article>

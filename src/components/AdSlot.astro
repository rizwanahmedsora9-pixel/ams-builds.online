---
/**
 * Google AdSense Ad Slot — settings-driven.
 * Enable AdSense & paste your Publisher ID via: CMS → Site Settings → Google AdSense.
 * Until then a labeled placeholder renders instead (layout stays stable).
 * Place inside blog posts, sidebar & listings for AdSense policy compliance.
 */
import { getSite, orUndef } from '../utils/site';

export interface Props {
  format?: 'leaderboard' | 'rectangle' | 'in-article' | 'responsive';
  slot?: string;
  class?: string;
  label?: string;
}
const { format = 'responsive', slot = '0000000000', class: cls = '', label = 'Advertisement' } = Astro.props;
const sizeClass = format === 'rectangle' ? 'ad-slot--rectangle' : format === 'in-article' ? 'ad-slot--in-article' : 'ad-slot--leaderboard';
const site = await getSite();
const enabled = site.adsenseEnabled && !!orUndef(site.adsenseClient);
---
<aside class:list={['ad-slot', sizeClass, cls]} aria-label={label}>
  {enabled && (
    <>
      <ins class="adsbygoogle" style="display:block" data-ad-client={site.adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </>
  )}
  {!enabled && (
    <span class="px-4 py-6">
      <span class="block text-[10px] tracking-[0.2em] uppercase text-slate-400 mb-1">{label}</span>
      <span class="block font-medium text-slate-500">AdSense Ad Unit — {format} • Slot {slot}</span>
      <span class="block text-slate-400 mt-1">Enable AdSense + add your Publisher ID in CMS → Site Settings</span>
    </span>
  )}
</aside>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import BlogCard from '../components/BlogCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
export const prerender = false;
import { contentCollection } from '../lib/content-source';
import { getSite } from '../utils/site';

const site = await getSite(Astro.locals);
const featuredProjects = (await contentCollection('projects', ({data}) => !data.draft && data.featured, Astro.locals)).slice(0,3);
const latestPosts = (await contentCollection('blog', ({data}) => !data.draft, Astro.locals)).sort((a,b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate)).slice(0,3);
const services = [
  { icon:'🌐', title:'Business Websites', desc:'Custom, lightning-fast websites for shops, clinics, schools & companies — SEO-ready, mobile-first and built to convert visitors into customers.', href:'/services/' },
  { icon:'📱', title:'Android App Development', desc:'Native & cross-platform Android apps — from idea and UI design to Play Store launch and ongoing maintenance.', href:'/services/' },
  { icon:'💻', title:'Custom Software', desc:'POS, inventory, school and business management software tailored to how your team actually works.', href:'/services/' },
  { icon:'🛒', title:'E-commerce & Web Apps', desc:'Online stores and web applications — catalogues, cart, payments and admin dashboards, end to end.', href:'/services/' },
];
const stats = site.stats?.length ? site.stats : [{ value:'50+', label:'Projects Delivered' }];
---
<BaseLayout title="Web & App Development Services" description={site.shortDescription}>
  <!-- HERO (content from CMS → Site Settings) -->
  <section class="bg-slate-900 text-white overflow-hidden relative">
    <div class="pointer-events-none absolute -top-32 -right-32 w-[30rem] h-[30rem] rounded-full bg-amber-500/10 blur-[120px]" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 md:py-24 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <p data-cms-hero-badge class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-amber-300 text-xs font-bold tracking-widest uppercase px-3 py-1.5 rounded-full">📍 {site.heroBadge}</p>
        <h1 data-cms-hero-title class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.08] mt-5 text-balance">{site.heroTitle}</h1>
        <p data-cms-hero-subtitle class="mt-5 text-base sm:text-lg text-slate-300 leading-7 sm:leading-8 max-w-xl">{site.heroSubtitle}</p>
        <div class="flex flex-col sm:flex-row gap-3 mt-8">
          <a data-cms-hero-cta href={site.heroCtaUrl} class="bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold px-7 py-3.5 rounded-xl text-center shadow-lg shadow-amber-500/20 transition">{site.heroCtaText} →</a>
          <a href="/projects/" class="bg-white/10 hover:bg-white/15 border border-white/20 font-bold px-7 py-3.5 rounded-xl text-center transition">View Our Work</a>
        </div>
        <dl data-cms-stats class="grid grid-cols-3 gap-4 mt-10 pt-8 border-t border-white/10 text-center">
          {stats.slice(0,3).map(s => <div><dt class="text-2xl font-extrabold text-white">{s.value}</dt><dd class="text-xs text-slate-400 mt-1">{s.label}</dd></div>)}
        </dl>
      </div>
      <div class="relative max-w-md w-full mx-auto lg:max-w-none">
        <div class="bg-white rounded-2xl shadow-2xl p-2 lg:rotate-1">
          <img data-cms-hero-image src={site.heroImage} alt={`${site.siteName} website dashboard preview`} class="rounded-xl w-full aspect-[1200/630] object-cover bg-slate-100" onerror="this.style.display='none'" />
          <div class="p-5">
            <p class="font-bold text-slate-900">Your business, online — 24/7</p>
            <p class="text-sm text-slate-600 mt-1">WhatsApp orders, Google Maps, online catalog & more.</p>
            <div class="flex gap-2 mt-4"><span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2.5 py-1 rounded-full">✓ SEO Ready</span><span class="text-xs bg-amber-100 text-amber-800 font-bold px-2.5 py-1 rounded-full">✓ AdSense Ready</span><span class="text-xs bg-blue-100 text-blue-800 font-bold px-2.5 py-1 rounded-full">✓ Mobile First</span></div>
          </div>
        </div>
        <div class="absolute -bottom-4 right-4 sm:left-auto sm:right-auto sm:-left-4 bg-amber-500 text-slate-900 font-extrabold px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl shadow-lg text-xs sm:text-sm">⚡ Loads in &lt; 1 second</div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-xs font-bold tracking-widest uppercase text-amber-600">Services</p>
      <h2 class="mt-2 text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">What we do</h2>
      <p class="mt-3 text-slate-600 leading-7">End-to-end web & app development services for businesses in Pakistan and beyond.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6 mt-12">
      {services.map(s => (
        <a href={s.href} class="group bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-soft hover:-translate-y-1 transition duration-300">
          <span class="text-3xl">{s.icon}</span>
          <h3 class="font-bold text-slate-900 mt-4 group-hover:text-amber-600">{s.title}</h3>
          <p class="text-sm text-slate-600 leading-6 mt-2">{s.desc}</p>
          <span class="inline-block mt-4 text-sm font-bold text-amber-600">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><AdSlot format="leaderboard" slot="8888888888" /></div>

  <!-- FEATURED PROJECTS -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex items-end justify-between gap-4">
        <div><h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Featured projects</h2><p class="text-slate-600 mt-2">Real work for real businesses.</p></div>
        <a href="/projects/" class="hidden sm:inline-block font-bold text-amber-600 shrink-0">All projects →</a>
      </div>
      <div data-cms-featured-projects class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        {featuredProjects.length ? featuredProjects.map(p => <ProjectCard project={p} />)
          : <p class="col-span-full text-center text-slate-400 py-12">No projects yet. <a href="/admin/" class="text-amber-600 font-semibold">Add your first project</a> in the admin panel.</p>}
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight tracking-tight">Why businesses choose AMS Builds</h2>
      <ul class="mt-6 space-y-4">
        {['Lightning-fast Astro websites — 95+ PageSpeed, zero bloat','SEO & AdSense-ready from day one — clean semantic HTML','Direct support in Urdu & English — WhatsApp, phone or email','Affordable PKR pricing with transparent packages','Simple CMS — log in at /admin and edit pages, projects & blog yourself'].map(t => <li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 grid place-items-center text-sm font-bold shrink-0">✓</span><span class="text-slate-700 leading-6">{t}</span></li>)}
      </ul>
      <a href="/about/" class="inline-block mt-8 bg-slate-900 text-white font-bold px-6 py-3 rounded-xl">About our agency →</a>
    </div>
    <div class="bg-slate-900 rounded-2xl p-6 sm:p-8 md:p-10 text-white shadow-soft">
      <h3 class="font-extrabold text-xl">Get a website like this</h3>
      <p class="text-slate-300 mt-2 leading-7 text-sm">Tell us about your business — we reply within 24 hours with a free quote and timeline.</p>
      <a href="/contact/" class="block text-center mt-6 bg-amber-500 text-slate-900 font-bold py-3.5 rounded-xl">Contact Us →</a>
      <p data-cms-contact-meta class="text-xs text-slate-400 mt-4 text-center">📞 {site.phone} · ✉️ {site.email}</p>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="max-w-5xl mx-auto relative overflow-hidden rounded-3xl bg-slate-900 text-white px-6 py-12 sm:px-12 sm:py-14 text-center">
      <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-amber-500/20 blur-[90px]" aria-hidden="true"></div>
      <h2 class="relative text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-balance">Ready to launch your next website or app?</h2>
      <p class="relative mt-4 text-slate-300 max-w-2xl mx-auto leading-7">Tell us about your business. We reply within 24 hours with a free quote and a clear timeline.</p>
      <div class="relative flex flex-col sm:flex-row justify-center gap-3 mt-8">
        <a href="/contact/" class="bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold px-7 py-3.5 rounded-xl transition">Get a Free Quote →</a>
        <a data-cms-wa-link href={`https://wa.me/${site.whatsapp.replace(/[^\d]/g, '')}`} rel="noopener" class="bg-white/10 hover:bg-white/15 border border-white/20 font-bold px-7 py-3.5 rounded-xl transition">Chat on WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex items-end justify-between gap-4">
        <div><h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Latest from our blog</h2><p class="text-slate-600 mt-2">Local business tips, costs & guides — AdSense-friendly content.</p></div>
        <a href="/blog/" class="hidden sm:inline-block font-bold text-amber-600 shrink-0">All articles →</a>
      </div>
      <div data-cms-latest-posts class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        {latestPosts.length ? latestPosts.map(p => <BlogCard post={p} />)
          : <p class="col-span-full text-center text-slate-400 py-12">No articles yet. <a href="/admin/" class="text-amber-600 font-semibold">Write the first post</a> in the admin panel.</p>}
      </div>
    </div>
  </section>
</BaseLayout>

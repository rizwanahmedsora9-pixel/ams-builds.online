---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const pages = await getCollection('pages', ({data}) => !data.draft);
  return pages.map(page => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const Content = await page.render();
---
<PageLayout title={page.data.title} description={page.data.description} heroTitle={page.data.heroTitle} heroSubtitle={page.data.heroSubtitle} slug={page.slug} seoTitle={page.data.seoTitle} seoDescription={page.data.seoDescription} ogImage={page.data.ogImage} noindex={page.data.noindex}><Content.Content /></PageLayout>

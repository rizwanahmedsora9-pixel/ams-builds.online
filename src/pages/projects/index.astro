---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({data}) => !data.draft)).sort((a,b) => +new Date(b.data.date) - +new Date(a.data.date));
---
<BaseLayout title="Our Projects — Websites & Apps" description="Case studies of business websites, Android apps and software built by AMS Builds in Gujrat, Pakistan.">
  <section class="bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <p class="text-amber-400 text-xs font-bold tracking-widest uppercase">Portfolio</p>
      <h1 class="text-3xl md:text-5xl font-extrabold mt-3">Our projects</h1>
      <p class="mt-3 text-slate-300 max-w-2xl leading-7">Websites, Android apps and software — with real results for local businesses.</p>
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <AdSlot format="leaderboard" slot="1010101010" />
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">{projects.map(p => <ProjectCard project={p} />)}</div>
  </div>
</BaseLayout>

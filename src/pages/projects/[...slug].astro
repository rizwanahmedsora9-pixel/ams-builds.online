---
export const prerender = true;
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { contentCollection } from '../../lib/content-source';
import { renderMarkdown } from '../../lib/render-markdown.mjs';
export async function getStaticPaths() {
  const projects = await contentCollection('projects', ({data}) => !data.draft);
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const html = await renderMarkdown(project.body);
---
<ProjectLayout project={project}><Fragment set:html={html} /></ProjectLayout>

---
export const prerender = true;
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { contentCollection } from '../../lib/content-source';
import { renderMarkdown } from '../../lib/render-markdown.mjs';
export async function getStaticPaths() {
  const posts = await contentCollection('blog', ({data}) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const all = await contentCollection('blog', ({data}) => !data.draft);
const others = all.filter(p => p.slug !== post.slug);
const related = others.filter(p => p.data.tags?.some(t => post.data.tags?.includes(t))).slice(0,3);
const html = await renderMarkdown(post.body);
---
<BlogPostLayout post={post} related={related.length ? related : others.slice(0,3)}><Fragment set:html={html} /></BlogPostLayout>

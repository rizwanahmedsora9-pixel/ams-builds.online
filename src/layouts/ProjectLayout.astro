---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import { getSite } from '../utils/site';
import type { CollectionEntry } from 'astro:content';

export interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const site = await getSite();
const base = site.url.replace(/\/$/, '');
const d = project.data;
const catLabel = { web:'Website', android:'Android App', software:'Software', ecommerce:'E-commerce' }[d.category];
const seoDesc = d.seoDescription || d.description;
const pageTitle = d.seoTitle || d.title;
const og = d.ogImage || d.coverImage;
---
<BaseLayout title={pageTitle} description={seoDesc} image={og} noindex={d.noindex} canonical={`${base}/projects/${project.slug}/`}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={[{label:'Home', href:'/'}, {label:'Projects', href:'/projects/'}, {label: d.title}]} />
    <span class="inline-block bg-slate-900 text-white text-xs font-bold px-3 py-1 rounded-full">{catLabel}</span>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mt-4 leading-tight">{d.title}</h1>
    <p class="mt-4 text-lg text-slate-600 leading-8">{d.description}</p>
    <div class="grid sm:grid-cols-3 gap-4 mt-8">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4"><p class="text-xs uppercase tracking-widest text-slate-500 font-bold">Client</p><p class="font-bold text-slate-900 mt-1">{d.client || 'Confidential'}</p></div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4"><p class="text-xs uppercase tracking-widest text-slate-500 font-bold">Date</p><p class="font-bold text-slate-900 mt-1">{d.date}</p></div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4"><p class="text-xs uppercase tracking-widest text-slate-500 font-bold">Category</p><p class="font-bold text-slate-900 mt-1">{catLabel}</p></div>
    </div>
    {d.coverImage && <img src={d.coverImage} alt={d.title} class="w-full rounded-2xl shadow-soft my-8" />}
    {d.technologies?.length > 0 && <div class="flex flex-wrap gap-2 mb-8">{d.technologies.map(t => <span class="bg-slate-100 px-3 py-1.5 rounded-full text-sm">{t}</span>)}</div>}
    <AdSlot format="leaderboard" slot="7777777777" />
    <div class="prose-ams"><slot /></div>
    {d.results?.length > 0 && (
      <section class="mt-10 bg-amber-50 border border-amber-200 rounded-2xl p-6">
        <h2 class="font-extrabold text-slate-900 text-xl">Results</h2>
        <ul class="mt-3 space-y-2">{d.results.map(r => <li class="flex gap-2"><span class="text-amber-600 font-bold">✓</span><span>{r}</span></li>)}</ul>
      </section>
    )}
    <div class="mt-10 flex flex-col sm:flex-row gap-4">
      {d.liveUrl && <a href={d.liveUrl} target="_blank" rel="noopener" class="flex-1 text-center bg-slate-900 text-white font-bold py-3.5 rounded-xl">Visit Live Project →</a>}
      <a href="/contact/" class="flex-1 text-center bg-amber-500 text-slate-900 font-bold py-3.5 rounded-xl">Start Similar Project</a>
    </div>
  </article>
</BaseLayout>

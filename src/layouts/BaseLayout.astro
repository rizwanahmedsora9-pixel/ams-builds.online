---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IntroOverlay from '../components/IntroOverlay.astro';
import { getSite, orUndef } from '../utils/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  noindex?: boolean;
}
const props = Astro.props;
const site = await getSite();
const adsenseClient = orUndef(site.adsenseClient);
const gaId = orUndef(site.googleAnalyticsId);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {...props} />
    {site.adsenseEnabled && adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>
    )}
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script set:html={`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${gaId}');`} />
      </>
    )}
  </head>
  <body>
    <IntroOverlay />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-amber-500 text-slate-900 px-4 py-2 rounded-lg font-bold z-[100]">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import { initCmsLive } from '../lib/cms-live.mjs';
      initCmsLive();
    </script>
  </body>
</html>

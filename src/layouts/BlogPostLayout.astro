---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import BlogCard from '../components/BlogCard.astro';
import { getSite } from '../utils/site';
import type { CollectionEntry } from 'astro:content';

export interface Props { post: CollectionEntry<'blog'>; related: CollectionEntry<'blog'>[]; }
const { post, related } = Astro.props;
const site = await getSite();
const base = site.url.replace(/\/$/, '');
const d = post.data;
const date = new Date(d.pubDate).toLocaleDateString('en-PK', { year:'numeric', month:'long', day:'numeric' });
const updated = d.updatedDate ? new Date(d.updatedDate).toLocaleDateString('en-PK', { year:'numeric', month:'long', day:'numeric' }) : null;
const seoDesc = d.seoDescription || d.description;
const pageTitle = d.seoTitle || d.title;
const og = d.ogImage || d.heroImage;
---
<BaseLayout title={pageTitle} description={seoDesc} image={og} type="article" publishedTime={d.pubDate} updatedTime={d.updatedDate} noindex={d.noindex} canonical={`${base}/blog/${post.slug}/`}>
  <article data-cms-detail="blog" data-cms-slug={post.slug} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={[{label:'Home', href:'/'}, {label:'Blog', href:'/blog/'}, {label: d.title}]} />
    <div class="grid lg:grid-cols-[1fr_320px] gap-10">
      <div>
        <header>
          <div class="flex flex-wrap gap-2 mb-4">
            {d.tags?.map(t => <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full">{t}</span>)}
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight">{d.title}</h1>
          <p class="mt-4 text-lg text-slate-600 leading-8">{d.description}</p>
          <div class="flex flex-wrap items-center gap-4 mt-6 text-sm text-slate-500 border-y border-slate-200 py-4">
            <span>By <strong class="text-slate-800">{d.author}</strong></span>
            <time datetime={d.pubDate}>Published {date}</time>
            {updated && <span>Updated {updated}</span>}
          </div>
        </header>

        {d.heroImage && <figure class="my-8 overflow-hidden rounded-2xl shadow-soft bg-slate-100"><img src={d.heroImage} alt={d.title} class="w-full aspect-[16/9] object-cover" /></figure>}

        <AdSlot format="leaderboard" slot="3333333333" />

        <div class="prose-ams"><slot /></div>

        <AdSlot format="in-article" slot="4444444444" />

        <div class="mt-10 bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col sm:flex-row gap-4 items-start">
          <span class="w-12 h-12 rounded-full bg-amber-500 text-slate-900 grid place-items-center font-black text-lg shrink-0">{site.logoInitial}</span>
          <div>
            <h2 class="font-bold text-slate-900">About the author</h2>
            <p class="text-sm text-slate-600 mt-1 leading-6"><strong>{d.author}</strong> — {site.siteName}, {site.addressLocality}, {site.addressCountry}. We build fast business websites, Android apps and software for clients everywhere.</p>
            <a href="/contact/" class="inline-block mt-3 bg-slate-900 text-white text-sm font-bold px-4 py-2 rounded-full">Work with us →</a>
          </div>
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <AdSlot format="rectangle" slot="5555555555" />
        <div class="bg-slate-900 text-white rounded-2xl p-6">
          <h2 class="font-bold text-lg">Need a website or app?</h2>
          <p class="text-sm text-slate-300 mt-2 leading-6">Get a free quote for your business. Fast delivery, SEO-ready, mobile-first.</p>
          <a href="/contact/" class="block text-center mt-4 bg-amber-500 text-slate-900 font-bold py-3 rounded-xl">Get Free Quote</a>
          <p class="text-xs text-slate-400 mt-3 text-center">📍 {site.addressLocality}, {site.addressCountry}</p>
        </div>
        <AdSlot format="rectangle" slot="6666666666" />
        <div class="border border-slate-200 rounded-2xl p-6">
          <h2 class="font-bold text-slate-900 mb-3">Popular tags</h2>
          <div class="flex flex-wrap gap-2">{[...new Set(related.flatMap(r => r.data.tags || []))].slice(0,8).map(t => <span class="text-xs bg-slate-100 px-3 py-1.5 rounded-full">{t}</span>)}</div>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-16">
        <h2 class="text-2xl font-extrabold text-slate-900 mb-6">Related articles</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{related.slice(0,3).map(r => <BlogCard post={r} />)}</div>
      </section>
    )}
  </article>
</BaseLayout>

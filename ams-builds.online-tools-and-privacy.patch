-`PIL` (Pillow) is one of the packages bundled with Pyodide: the first visitor to run the app downloads it (a few MB) and the browser caches it afterwards. Both directions are limited to 20 MB per file, and the file the visitor chooses never touches your server — it goes from their disk into the page's memory.
+`PIL` (Pillow) is one of the packages bundled with Pyodide: the first visitor to run the app downloads it (a few MB) and the browser caches it afterwards. Both directions are limited to 20 MB per file, and the file the visitor chooses never touches your CMS server — it goes from their device into the page's memory, then into a browser-local worker. The QR sample automatically downloads its small `qrcode` package on first run; this is app code, not visitor data. The built-in image and QR samples do not upload the visitor's file or entered text.
 
 When an app does not run, the block itself says why:
 
diff --git a/samples/python/09-image-compressor.py b/samples/python/09-image-compressor.py
new file mode 100644
index 0000000..969ae59
--- /dev/null
+++ b/samples/python/09-image-compressor.py
@@ -0,0 +1,35 @@
+# Compress an image in the visitor's browser, then download the smaller JPEG.
+# Pillow (PIL) is bundled with Pyodide; no Python install or server upload.
+from PIL import Image
+from io import BytesIO
+
+source = ams_pick_file("image/*")
+if not source:
+    print("No image chosen.")
+else:
+    image = Image.open(source)
+    original_size = image.width, image.height
+    original_bytes = len(open(source, "rb").read())
+
+    # Resize very large phone photos before encoding. Change this limit or the
+    # quality below to tune the balance between size and detail.
+    image.thumbnail((2000, 2000))
+    if image.mode in ("RGBA", "LA") or "transparency" in image.info:
+        rgba = image.convert("RGBA")
+        background = Image.new("RGB", rgba.size, "white")
+        background.paste(rgba, mask=rgba.getchannel("A"))
+        image = background
+    else:
+        image = image.convert("RGB")
+
+    result = BytesIO()
+    image.save(result, format="JPEG", quality=78, optimize=True)
+    output = "compressed-image.jpg"
+    with open(output, "wb") as handle:
+        handle.write(result.getvalue())
+
+    saved = max(0, original_bytes - len(result.getvalue()))
+    print(f"Original: {original_size[0]} × {original_size[1]} px, {original_bytes:,} bytes")
+    print(f"Compressed: {image.width} × {image.height} px, {len(result.getvalue()):,} bytes")
+    print(f"Saved {saved:,} bytes. The original file never left your device.")
+    ams_download(output)
diff --git a/samples/python/10-qr-code-maker.py b/samples/python/10-qr-code-maker.py
new file mode 100644
index 0000000..e3af9d0
--- /dev/null
+++ b/samples/python/10-qr-code-maker.py
@@ -0,0 +1,17 @@
+# Make a QR code from a short text or URL; download it as a crisp SVG.
+# The browser fetches this small pure-Python package automatically on first run.
+import micropip
+await micropip.install("qrcode==8.2")
+
+import qrcode
+from qrcode.image.svg import SvgPathImage
+
+text = input("Text or URL for the QR code: ").strip()
+if not text:
+    print("Enter some text or a URL and restart the app.")
+else:
+    image = qrcode.make(text, image_factory=SvgPathImage, box_size=8, border=4)
+    output = "qr-code.svg"
+    image.save(output)
+    print("QR code created. Download the SVG below.")
+    ams_download(output)

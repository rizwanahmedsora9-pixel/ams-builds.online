{
  "manifest_version": 3,
  "name": "Site Theme",
  "slug": "site-theme",
  "version": "1.0.0",
  "author": "Test suite",
  "description": "The theme the test suite uploads: a complete package (templates, partials, stylesheet, script, settings) used to exercise the theme engine end to end. The app itself ships no themes.",
  "cms_compatibility": {
    "min": "0.9.0",
    "max": "0.9.x"
  },
  "preview": [
    "#f6f8fc",
    "#0f1a2c",
    "#2457d6"
  ],
  "screenshot": "",
  "required_templates": [
    "base",
    "home",
    "page",
    "post",
    "archive",
    "404"
  ],
  "optional_templates": [
    "search"
  ],
  "features": [
    "menus",
    "page-hierarchy",
    "responsive-navigation",
    "theme-settings"
  ],
  "menu_locations": [
    "primary",
    "footer"
  ],
  "templates": {
    "404": "templates/404.html",
    "base": "templates/base.html",
    "home": "templates/home.html",
    "page": "templates/page.html",
    "post": "templates/post.html",
    "archive": "templates/archive.html",
    "search": "templates/search.html"
  },
  "partials": {
    "header": "partials/header.html",
    "navigation": "partials/navigation.html",
    "footer": "partials/footer.html",
    "social": "partials/social.html"
  },
  "css": "static/css/style.css",
  "asset_entrypoints": {
    "css": "static/css/style.css",
    "js": [
      "static/js/theme.js"
    ]
  },
  "assets": [
    "static/js/theme.js"
  ],
  "settings_schema": "config/settings.json",
  "changelog": [
    {
      "version": "1.0.0",
      "notes": "Test fixture: the package the suite installs, previews and edits."
    }
  ]
}

+    {{#if theme.hero_subtitle}}<p class="hero__lead">{{theme.hero_subtitle}}</p>{{/if}}
+    {{#if page}}<div class="hero__intro prose">{{{page.content}}}</div>{{/if}}
+    {{#unless page}}<p class="hero__intro">Your pages, posts, menus and media stay in the CMS. The theme controls their presentation.</p>{{/unless}}
+    <div class="hero__actions">
+      <a class="button" href="{{#if theme.hero_cta_url}}{{theme.hero_cta_url}}{{else}}/blog{{/if}}"><span>{{#if theme.hero_cta_label}}{{theme.hero_cta_label}}{{else}}Explore the blog{{/if}}</span><svg class="icon icon--dir" aria-hidden="true"><use href="#i-arrow"></use></svg></a>

+</section>{{/if}}
+
+<section class="home-section"><div class="section-heading"><div><p class="eyebrow">From the blog</p><h2>Latest posts</h2></div><a class="section-link" href="/blog">All posts <svg class="icon icon--dir" aria-hidden="true"><use href="#i-arrow"></use></svg></a></div>
+  {{#if posts}}<div class="post-grid post-grid--featured">{{#each posts}}<article class="post-card">{{#if featured_image}}<a class="post-card__media" href="{{url}}" tabindex="-1" aria-hidden="true"><img class="post-card__image" src="{{featured_image}}" alt="{{featured_alt}}" loading="lazy"></a>{{/if}}<div class="post-card__body"><p class="meta"><svg class="icon" aria-hidden="true"><use href="#i-calendar"></use></svg><span>{{date}}</span></p><h3><a href="{{url}}">{{title}}</a></h3><p class="post-card__excerpt">{{excerpt}}</p><a class="read-more" href="{{url}}">Read more <svg class="icon icon--dir" aria-hidden="true"><use href="#i-arrow"></use></svg></a></div></article>{{/each}}</div>{{else}}<p class="empty">No published posts yet. Add your first post in the CMS.</p>{{/if}}
+</section>

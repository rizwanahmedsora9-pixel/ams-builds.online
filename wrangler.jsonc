{
  // Static asset hosting for dist/ (works with `wrangler dev` and Cloudflare Workers Builds)
  "name": "ams-builds-online",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}

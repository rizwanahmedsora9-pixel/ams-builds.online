{
  "name": "ams-builds-online",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/admin",
      "/auth",
      "/callback",
      "/api/auth",
      "/api/callback"
    ]
  },
  "previews": {},
  "observability": {
    "enabled": true
  }
}
